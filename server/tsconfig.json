{
	"compilerOptions": {
		"target": "es6",
		"module": "CommonJS",
		"moduleResolution": "node",
		"noImplicitAny": false,
		"removeComments": true,
		"allowSyntheticDefaultImports": true,
		"preserveConstEnums": true,
		"sourceMap": true,
		"composite": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"rootDir": "./src",
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.spec.ts", "node_modules"]
}
